#!/usr/bin/env bash
#
# ffgif: turn a video into a good-looking GIF.
#
set -euo pipefail
export LC_NUMERIC=C

readonly PROG=${0##*/}

usage() {
  cat <<EOF
Usage: $PROG [options] VIDEO [OUTPUT.gif]

Make a GIF from VIDEO (default output: NAME.gif next to it). It builds a
custom colour palette from the video first, which gives far better
colours and smaller files than a plain conversion.

GIFs get big fast: keep them short, narrow and at a low frame rate.

Options:
  -s, --start TIME     start at TIME: seconds or [HH:]MM:SS (default: 0)
  -t, --duration SECS  how many seconds to include (default: the rest of
                       the video)
  -w, --width PIXELS   width; the height follows (default: 480, never
                       wider than the video)
  -r, --fps N          frames per second (default: 12)
      --once           play once instead of looping forever
  -f, --force          overwrite the output if it already exists
  -h, --help           show this help

Examples:
  $PROG screen-capture.mov
  $PROG -s 1:05 -t 4 -w 320 match.mp4 goal.gif
EOF
}

die() { printf '%s: %s\n' "$PROG" "$*" >&2; exit 1; }
usage_error() { printf '%s: %s\nTry "%s --help".\n' "$PROG" "$*" "$PROG" >&2; exit 2; }
have() { command -v "$1" >/dev/null 2>&1; }

start='' length='' width=480 fps=12 loop=0 force=0 args=()
while [ $# -gt 0 ]; do
  case $1 in
    -s|--start)    [ $# -ge 2 ] || usage_error "$1 needs a value"; start=$2; shift ;;
    -t|--duration) [ $# -ge 2 ] || usage_error "$1 needs a value"; length=$2; shift ;;
    -w|--width)    [ $# -ge 2 ] || usage_error "$1 needs a value"; width=$2; shift ;;
    -r|--fps)      [ $# -ge 2 ] || usage_error "$1 needs a value"; fps=$2; shift ;;
    --once)        loop=-1 ;;
    -f|--force)    force=1 ;;
    -h|--help)     usage; exit 0 ;;
    --)            shift; args+=("$@"); break ;;
    -*)            usage_error "unknown option: $1" ;;
    *)             args+=("$1") ;;
  esac
  shift
done
[ ${#args[@]} -ge 1 ] || usage_error "give a video to convert"
[ ${#args[@]} -le 2 ] || usage_error "too many arguments"
input=${args[0]} output=${args[1]:-}

# Seconds from "90", "12.5", "1:30" or "01:02:03.5"; fails on anything else.
to_seconds() {
  printf '%s\n' "$1" | awk -F: '
    NF < 1 || NF > 3 { exit 1 }
    { for (i = 1; i <= NF; i++) if ($i !~ /^([0-9]+\.?[0-9]*|\.[0-9]+)$/) exit 1
      s = 0; for (i = 1; i <= NF; i++) s = s * 60 + $i
      printf "%.3f\n", s }'
}

if [ -n "$start" ]; then
  start=$(to_seconds "$start") || usage_error "bad --start time (use seconds or [HH:]MM:SS)"
fi
if [ -n "$length" ]; then
  length=$(to_seconds "$length") || usage_error "bad --duration (use seconds)"
  awk -v l="$length" 'BEGIN { exit !(l > 0) }' || usage_error "--duration must be more than 0"
fi
case $width in ''|*[!0-9]*|0) usage_error "--width must be a whole number of pixels" ;; esac
case $fps in ''|*[!0-9]*|0) usage_error "--fps must be a whole number" ;; esac

[ -f "$input" ] || die "no such file: $input"
{ have ffmpeg && have ffprobe; } || die "needs ffmpeg (macOS: brew install ffmpeg; Debian/Ubuntu: sudo apt install ffmpeg)"

if [ -z "$output" ]; then
  dir=$(dirname -- "$input") base=$(basename -- "$input")
  case $base in ?*.*) base=${base%.*} ;; esac
  output=$base.gif
  [ "$dir" = . ] || output=$dir/$output
fi
case $output in *.gif|*.GIF) ;; *) usage_error "the output name must end in .gif" ;; esac
case $input in -*) input=./$input ;; esac
case $output in -*) output=./$output ;; esac
if [ -e "$output" ]; then
  [ ! "$output" -ef "$input" ] || die "the output can't be the input file"
  [ "$force" -eq 1 ] || die "$output already exists (use --force to overwrite)"
fi

set --
[ -z "$start" ] || set -- -ss "$start"
set -- "$@" -i "$input"
[ -z "$length" ] || set -- "$@" -t "$length"

# One pass: split the frames, build a palette from one copy (stats_mode=diff
# favours what moves), and map the other copy onto it. Bayer dithering keeps
# the file smaller than error-diffusion dithering would.
filter="fps=$fps,scale='min($width,iw)':-1:flags=lanczos,split[a][b];[a]palettegen=stats_mode=diff[p];[b][p]paletteuse=dither=bayer:bayer_scale=4:diff_mode=rectangle"

stats=-nostats
[ -t 2 ] && stats=-stats
partial=$(dirname -- "$output")/.$(basename -- "$output").partial.$$.gif
trap 'rm -f "$partial"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

if ffmpeg -hide_banner -nostdin -loglevel error "$stats" "$@" -filter_complex "$filter" -loop "$loop" -y "$partial"; then
  mv -f "$partial" "$output"
  size=$(wc -c <"$output" | tr -d ' ')
  printf '%s -> %s (%s)\n' "$input" "$output" "$(awk -v b="$size" 'BEGIN {
    if (b >= 1048576) printf "%.1f MB", b / 1048576; else printf "%d KB", b / 1024 + 0.5 }')"
else
  die "ffmpeg couldn't make a GIF from $input"
fi
