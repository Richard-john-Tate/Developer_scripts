#!/usr/bin/env bash
#
# wait-for: wait until a TCP port or HTTP URL is up, then run a command.
#
set -euo pipefail

readonly PROG=${0##*/}

usage() {
  cat <<EOF
Usage: $PROG [options] TARGET... [-- COMMAND [ARGS...]]

Wait until every TARGET is reachable, then run COMMAND (if given). Useful
in docker-compose entrypoints and CI scripts that have to wait for a
database or web server before starting.

A TARGET is one of:
  HOST:PORT                  a TCP port that accepts connections
  PORT                       short for localhost:PORT
  http://... or https://...  a URL that answers with a 2xx or 3xx status
                             (needs curl or wget)

Options:
  -t, --timeout SECS   give up after SECS seconds (default: 30, 0 = never)
  -i, --interval SECS  seconds between attempts (default: 1)
  -q, --quiet          print nothing, just set the exit status
  -h, --help           show this help

Exit status is 0 when everything is up, or COMMAND's exit status if you gave
one. It is 1 when the timeout runs out.

Examples:
  $PROG db:5432 -- ./migrate.sh
  $PROG -t 60 localhost:6379 http://localhost:8080/health
EOF
}

usage_error() { printf '%s: %s\nTry "%s --help".\n' "$PROG" "$*" "$PROG" >&2; exit 2; }
have() { command -v "$1" >/dev/null 2>&1; }

timeout=30 interval=1 quiet=0 targets=()
while [ $# -gt 0 ]; do
  case $1 in
    -t|--timeout)  [ $# -ge 2 ] || usage_error "$1 needs a value"; timeout=$2; shift ;;
    -i|--interval) [ $# -ge 2 ] || usage_error "$1 needs a value"; interval=$2; shift ;;
    -q|--quiet)    quiet=1 ;;
    -h|--help)     usage; exit 0 ;;
    --)            shift; break ;;
    -*)            usage_error "unknown option: $1" ;;
    *)             targets+=("$1") ;;
  esac
  shift
done
# Whatever is left in "$@" is the command to run.

[ ${#targets[@]} -gt 0 ] || usage_error "give at least one HOST:PORT or URL to wait for"
case $timeout in ''|*[!0-9]*) usage_error "--timeout must be a whole number of seconds" ;; esac
case $interval in ''|*[!0-9.]*) usage_error "--interval must be a number of seconds" ;; esac

say() { [ "$quiet" -eq 1 ] || printf '%s: %s\n' "$PROG" "$*" >&2; }

# Try to open a TCP connection, giving up after about 2 seconds. Uses bash's
# /dev/tcp so there's no dependency on which flavour of nc is installed.
tcp_open() {
  ( exec 3<>"/dev/tcp/$1/$2" ) 2>/dev/null &
  local pid=$! tries=0
  while kill -0 "$pid" 2>/dev/null; do
    tries=$((tries + 1))
    if [ $tries -gt 20 ]; then
      kill "$pid" 2>/dev/null || true
      wait "$pid" 2>/dev/null || true
      return 1
    fi
    sleep 0.1
  done
  wait "$pid"
}

# Why the last check failed, shown if we time out.
last_error=''

http_ok() {
  if have curl; then
    # --connect-timeout: a connection that hangs (macOS silently drops them
    # while a server is still starting) is retried instead of eating 5s.
    last_error=$(curl -fsS -o /dev/null --connect-timeout 2 --max-time 5 "$1" 2>&1)
  elif have wget; then
    last_error=$(wget -q -O /dev/null -T 5 "$1" 2>&1) && return 0
    last_error=${last_error:-wget: request failed}
    return 1
  else
    printf '%s: need curl or wget to check URLs\n' "$PROG" >&2
    exit 2
  fi
}

# Check one target; returns 0 if it is up.
check() {
  local target=$1 host port
  case $target in
    http://*|https://*) http_ok "$target"; return ;;
    \[*\]:*) host=${target%]:*}; host=${host#[}; port=${target##*]:} ;;  # [::1]:8080
    *:*)     host=${target%:*}; port=${target##*:} ;;
    *)       host=localhost; port=$target ;;
  esac
  last_error="nothing accepted a connection on ${host:-localhost} port $port"
  tcp_open "${host:-localhost}" "$port"
}

# Validate targets up front so typos fail fast instead of timing out.
for target in "${targets[@]}"; do
  case $target in
    http://*|https://*) ;;
    *) port=${target##*:}
       case $port in ''|*[!0-9]*) usage_error "bad target '$target' (expected HOST:PORT, PORT or a URL)" ;; esac ;;
  esac
done

SECONDS=0
for target in "${targets[@]}"; do
  say "waiting for $target"
  until check "$target"; do
    if [ "$timeout" -gt 0 ] && [ "$SECONDS" -ge "$timeout" ]; then
      say "timed out after ${timeout}s waiting for $target"
      [ -z "$last_error" ] || say "last attempt: $last_error"
      exit 1
    fi
    sleep "$interval"
  done
  say "$target is up (after ${SECONDS}s)"
done

if [ $# -gt 0 ]; then
  exec "$@"
fi
