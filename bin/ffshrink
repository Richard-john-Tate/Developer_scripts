#!/usr/bin/env bash
#
# ffshrink: make videos smaller for sharing.
#
set -euo pipefail
export LC_NUMERIC=C

readonly PROG=${0##*/}

usage() {
  cat <<EOF
Usage: $PROG [options] VIDEO...

Re-encode videos so they're smaller and play almost anywhere: H.264 video
and AAC audio in an MP4, ready for chat apps, email and the web. Each
VIDEO is saved as NAME.small.mp4 next to the original.

Options:
  -q, --quality N     quality from 0 to 51; lower is better and bigger
                      (default: 23; try 28 for much smaller files)
  -r, --resolution P  shrink to at most P lines, e.g. 1080, 720 or 480.
                      Counts the short side, so 720 means 720p for
                      portrait phone videos too. Never enlarges
  -s, --size SIZE     aim for a file of about SIZE, e.g. 25M, 500K or 1.5G,
                      for upload limits. Uses two passes; ignores --quality
      --hevc          use H.265 instead: about 40% smaller at the same
                      quality, but some older devices can't play it
  -m, --mute          drop the audio
  -p, --preset NAME   encoder speed: ultrafast ... medium ... veryslow;
                      slower gives smaller files (default: medium)
  -o, --output FILE   where to write (only with a single VIDEO)
  -f, --force         overwrite output files that already exist
  -h, --help          show this help

Examples:
  $PROG screen-recording.mov
  $PROG -r 720 -q 28 *.mp4
  $PROG -s 25M -o for-discord.mp4 gameplay.mkv
EOF
}

die() { printf '%s: %s\n' "$PROG" "$*" >&2; exit 1; }
usage_error() { printf '%s: %s\nTry "%s --help".\n' "$PROG" "$*" "$PROG" >&2; exit 2; }
have() { command -v "$1" >/dev/null 2>&1; }

quality='' resolution='' size='' hevc=0 mute=0 preset=medium output='' force=0 inputs=()
while [ $# -gt 0 ]; do
  case $1 in
    -q|--quality)    [ $# -ge 2 ] || usage_error "$1 needs a value"; quality=$2; shift ;;
    -r|--resolution) [ $# -ge 2 ] || usage_error "$1 needs a value"; resolution=${2%p}; shift ;;
    -s|--size)       [ $# -ge 2 ] || usage_error "$1 needs a value"; size=$2; shift ;;
    --hevc|--h265)   hevc=1 ;;
    -m|--mute)       mute=1 ;;
    -p|--preset)     [ $# -ge 2 ] || usage_error "$1 needs a value"; preset=$2; shift ;;
    -o|--output)     [ $# -ge 2 ] || usage_error "$1 needs a value"; output=$2; shift ;;
    -f|--force)      force=1 ;;
    -h|--help)       usage; exit 0 ;;
    --)              shift; inputs+=("$@"); break ;;
    -*)              usage_error "unknown option: $1" ;;
    *)               inputs+=("$1") ;;
  esac
  shift
done
[ ${#inputs[@]} -gt 0 ] || usage_error "give at least one video"
[ -z "$output" ] || [ ${#inputs[@]} -eq 1 ] || usage_error "--output only works with a single video"

if [ -n "$quality" ]; then
  case $quality in ''|*[!0-9]*) usage_error "--quality must be a number from 0 to 51" ;; esac
  [ "$quality" -le 51 ] || usage_error "--quality must be a number from 0 to 51"
fi
case $resolution in *[!0-9]*) usage_error "--resolution takes a number of lines, e.g. 720" ;; esac
case $preset in
  ultrafast|superfast|veryfast|faster|fast|medium|slow|slower|veryslow) ;;
  *) usage_error "unknown preset '$preset'" ;;
esac

# "25M" -> bytes (25000000). Decimal units, so the result fits limits that
# are stated either way.
target_bytes=''
if [ -n "$size" ]; then
  target_bytes=$(printf '%s\n' "$size" | awk '
    match(toupper($0), /^[0-9]+(\.[0-9]+)?[KMG]?I?B?$/) {
      n = $0 + 0; u = toupper($0); gsub(/[0-9.IB]/, "", u)
      m = (u == "K") ? 1e3 : (u == "M") ? 1e6 : (u == "G") ? 1e9 : 1
      printf "%d\n", n * m; exit 0
    }
    { exit 1 }') || usage_error "--size takes a size like 25M, 500K or 1.5G"
fi

{ have ffmpeg && have ffprobe; } || die "needs ffmpeg (macOS: brew install ffmpeg; Debian/Ubuntu: sudo apt install ffmpeg)"
if [ "$hevc" -eq 1 ]; then encoder=libx265; else encoder=libx264; fi
# (Not "ffmpeg | grep -q": grep quitting early would make the pipe fail.)
case $(ffmpeg -hide_banner -encoders 2>/dev/null) in
  *" $encoder "*) ;;
  *) die "your ffmpeg wasn't built with $encoder" ;;
esac

stats=-nostats
[ -t 2 ] && stats=-stats
# ffmpeg, quietly: errors and a progress line only. -nostdin stops it eating
# keypresses (and the rest of a loop's input).
ff() { ffmpeg -hide_banner -nostdin -loglevel error "$stats" "$@"; }

# Write ffmpeg's output to a temporary file and move it into place when it
# succeeds, so a failed or interrupted run never leaves a broken file.
partial='' passlog=''
# shellcheck disable=SC2329  # called by the EXIT trap
cleanup() {
  [ -z "$partial" ] || rm -f "$partial"
  [ -z "$passlog" ] || rm -f "$passlog"*
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

human() { awk -v b="$1" 'BEGIN { split("B KB MB GB TB", u, " ")
  for (i = 1; b >= 1024 && i < 5; i++) b /= 1024
  fmt = (i == 1) ? "%d %s" : "%.1f %s"; printf fmt, b, u[i] }'; }
filesize() { wc -c <"$1" | tr -d ' '; }

# Work out every output name first, so nothing is encoded if any would fail.
outputs=()
for input in "${inputs[@]}"; do
  [ -f "$input" ] || die "no such file: $input"
  if [ -n "$output" ]; then
    out=$output
  else
    dir=$(dirname -- "$input") base=$(basename -- "$input")
    case $base in ?*.*) base=${base%.*} ;; esac
    out=$base.small.mp4
    [ "$dir" = . ] || out=$dir/$out
  fi
  case $out in -*) out=./$out ;; esac
  case $out in *.mp4|*.MP4|*.m4v|*.mov|*.mkv) ;; *) die "$out: the output must be .mp4, .m4v, .mov or .mkv" ;; esac
  if [ -e "$out" ]; then
    [ ! "$out" -ef "$input" ] || die "$out is the input file; choose another --output"
    [ "$force" -eq 1 ] || die "$out already exists (use --force to overwrite)"
  fi
  outputs+=("$out")
done

status=0
i=0
for input in "${inputs[@]}"; do
  out=${outputs[$i]}
  i=$((i + 1))
  case $input in -*) input=./$input ;; esac

  # Video: scale the short side down to the resolution, keeping the shape;
  # yuv420p is the pixel format every player understands.
  vf=''
  if [ -n "$resolution" ]; then
    vf="scale='if(gte(iw,ih),-2,min($resolution,iw))':'if(gte(iw,ih),min($resolution,ih),-2)'"
  fi
  set -- -map 0:v:0 -c:v "$encoder" -preset "$preset" -pix_fmt yuv420p
  [ -z "$vf" ] || set -- "$@" -vf "$vf"
  if [ "$hevc" -eq 1 ]; then
    set -- "$@" -tag:v hvc1 -x265-params log-level=error   # hvc1: lets Apple devices play it
  fi
  if [ "$mute" -eq 1 ]; then
    audio=(-an); audio_kbps=0
  else
    audio=(-map '0:a:0?' -c:a aac -b:a 128k); audio_kbps=128
  fi

  dir=$(dirname -- "$out") base=$(basename -- "$out")
  partial=$dir/.$base.partial.$$.${base##*.}   # keep the extension; ffmpeg picks the format from it

  printf '%s -> %s\n' "$input" "$out" >&2
  if [ -n "$target_bytes" ]; then
    duration=$(ffprobe -v error -show_entries format=duration -of default=nw=1:nk=1 -- "$input" 2>/dev/null || true)
    case $duration in ''|*[!0-9.]*) printf '%s: %s: can'\''t tell how long it is, so --size won'\''t work\n' "$PROG" "$input" >&2; status=1; continue ;; esac
    # Bits available per second, minus audio and ~4% for the container.
    video_kbps=$(awk -v b="$target_bytes" -v d="$duration" -v a="$audio_kbps" \
      'BEGIN { printf "%d", b * 8 / 1000 / d * 0.96 - a }')
    if [ "$video_kbps" -lt 50 ]; then
      printf '%s: %s: %s is too small for a video this long; try a bigger --size or --mute\n' "$PROG" "$input" "$size" >&2
      status=1
      continue
    fi
    passlog=$dir/.$base.passlog.$$
    if [ "$hevc" -eq 1 ]; then
      pass1=(-b:v "${video_kbps}k" -x265-params "log-level=error:pass=1:stats=$passlog")
      pass2=(-b:v "${video_kbps}k" -x265-params "log-level=error:pass=2:stats=$passlog")
    else
      pass1=(-b:v "${video_kbps}k" -pass 1 -passlogfile "$passlog")
      pass2=(-b:v "${video_kbps}k" -pass 2 -passlogfile "$passlog")
    fi
    if ff -i "$input" "$@" "${pass1[@]}" -an -f null - &&
       ff -i "$input" "$@" "${pass2[@]}" "${audio[@]}" -movflags +faststart -y "$partial"; then
      ok=1
    else
      ok=0
    fi
    rm -f "$passlog"*
    passlog=''
  else
    if [ -n "$quality" ]; then crf=$quality
    elif [ "$hevc" -eq 1 ]; then crf=28   # the same quality as x264's 23
    else crf=23
    fi
    if ff -i "$input" "$@" -crf "$crf" "${audio[@]}" -movflags +faststart -y "$partial"; then
      ok=1
    else
      ok=0
    fi
  fi

  if [ "$ok" -eq 1 ]; then
    mv -f "$partial" "$out"
    partial=''
    before=$(filesize "$input") after=$(filesize "$out")
    printf '  %s -> %s (%d%% of the original)\n' "$(human "$before")" "$(human "$after")" \
      "$(( before > 0 ? after * 100 / before : 0 ))" >&2
  else
    rm -f "$partial"
    partial=''
    printf '%s: failed to encode %s\n' "$PROG" "$input" >&2
    status=1
  fi
done
exit "$status"
