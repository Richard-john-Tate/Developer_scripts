#!/usr/bin/env bash
#
# favicon: make every favicon and app icon a website needs from one image.
#
set -euo pipefail

readonly PROG=${0##*/}

usage() {
  cat <<EOF
Usage: $PROG [options] IMAGE

Make the icon files a website needs from one image, ideally a square PNG
of at least 512x512 (an SVG works if your ImageMagick can read SVG):

  favicon.ico           16, 32 and 48 pixels in one file, for browsers
  favicon-32x32.png     for browsers that prefer PNG
  apple-touch-icon.png  180x180 for iPhone and iPad home screens, on a
                        solid background (iOS shows transparency as black)
  icon-192.png          for Android and the web app manifest
  icon-512.png          for Android splash screens and app stores

A non-square image is centred on a transparent square instead of being
stretched. Then it prints the HTML to paste into your page's <head>.

Options:
  -d, --dir DIR         where to put the icons (default: ./favicon)
  -b, --background COL  background for apple-touch-icon.png (default:
                        white), e.g. black, "#1e293b"
  -f, --force           overwrite icon files that already exist
  -h, --help            show this help

Example:
  $PROG -d public logo.png
EOF
}

die() { printf '%s: %s\n' "$PROG" "$*" >&2; exit 1; }
usage_error() { printf '%s: %s\nTry "%s --help".\n' "$PROG" "$*" "$PROG" >&2; exit 2; }
have() { command -v "$1" >/dev/null 2>&1; }

dir=favicon background=white force=0 args=()
while [ $# -gt 0 ]; do
  case $1 in
    -d|--dir)        [ $# -ge 2 ] || usage_error "$1 needs a value"; dir=$2; shift ;;
    -b|--background) [ $# -ge 2 ] || usage_error "$1 needs a value"; background=$2; shift ;;
    -f|--force)      force=1 ;;
    -h|--help)       usage; exit 0 ;;
    --)              shift; args+=("$@"); break ;;
    -*)              usage_error "unknown option: $1" ;;
    *)               args+=("$1") ;;
  esac
  shift
done
[ ${#args[@]} -eq 1 ] || usage_error "give exactly one image"
input=${args[0]}
[ -f "$input" ] || die "no such file: $input"
case $input in -*) input=./$input ;; esac
case $dir in -*) dir=./$dir ;; esac

# ImageMagick 7 is one "magick" command; version 6 has "convert" and "identify".
if have magick; then
  IM=(magick) IDENTIFY=(magick identify)
elif have convert && have identify; then
  IM=(convert) IDENTIFY=(identify)
else
  die "needs ImageMagick (macOS: brew install imagemagick; Debian/Ubuntu: sudo apt install imagemagick)"
fi

# Read SVGs at a high density so they're rasterised sharply, with a
# transparent background.
hint=''
case $(printf '%s' "$input" | tr '[:upper:]' '[:lower:]') in
  *.svg) src=(-background none -density 384 "${input}[0]")
         hint=' (reading SVG needs ImageMagick built with SVG support, e.g. librsvg)' ;;
  *)     src=("${input}[0]") ;;
esac

size=$("${IDENTIFY[@]}" -format '%w %h' "${src[@]}" 2>/dev/null) ||
  die "ImageMagick can't read $input$hint"
width=${size% *} height=${size#* }
side=$(( width > height ? width : height ))
if [ "$side" -lt 512 ]; then
  printf '%s: warning: %s is only %sx%s; icon-512.png will be blurry (start from 512x512 or bigger)\n' \
    "$PROG" "$input" "$width" "$height" >&2
fi

files='favicon.ico favicon-32x32.png apple-touch-icon.png icon-192.png icon-512.png'
if [ "$force" -eq 0 ]; then
  for f in $files; do
    [ ! -e "$dir/$f" ] || die "$dir/$f already exists (use --force to overwrite)"
  done
fi
mkdir -p "$dir"

partial=''
trap '[ -z "$partial" ] || rm -f "$partial"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# Centre the image on a transparent square, so nothing gets stretched.
square=(-background none -gravity center -extent "${side}x${side}")

# make FILE FORMAT ImageMagick-options...: write $dir/FILE via a temp file.
make() {
  local file=$1 format=$2
  shift 2
  partial=$dir/.$file.partial.$$
  if "${IM[@]}" "${src[@]}" "${square[@]}" "$@" "$format:$partial" && [ -s "$partial" ]; then
    mv -f "$partial" "$dir/$file"
    partial=''
    echo "  $dir/$file"
  else
    rm -f "$partial"
    die "failed to make $dir/$file"
  fi
}

echo "Made:"
make favicon.ico ICO -define icon:auto-resize=48,32,16
make favicon-32x32.png PNG -resize 32x32
make apple-touch-icon.png PNG -resize 180x180 -background "$background" -alpha remove -alpha off
make icon-192.png PNG -resize 192x192
make icon-512.png PNG -resize 512x512

cat <<'EOF'

Put the files at the root of your site and add this to <head>:

  <link rel="icon" href="/favicon.ico" sizes="48x48">
  <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">

and list the larger icons in site.webmanifest:

  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" }
  ]
EOF
