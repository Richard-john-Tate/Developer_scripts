#!/usr/bin/env bash
#
# gensecret: generate random passwords, tokens and keys.
#
set -euo pipefail

readonly PROG=${0##*/}

usage() {
  cat <<EOF
Usage: $PROG [options] [LENGTH]

Print a random secret made from your operating system's secure random
number generator (/dev/urandom).

Options:
  -t, --type TYPE  what kind of secret (default: alnum):
                     alnum    letters and digits
                     strong   letters, digits and symbols; at least one of
                              each kind (for picky password rules)
                     hex      hexadecimal, e.g. for API keys
                     base64   standard base64
                     url      URL-safe base64 (A-Z a-z 0-9 - _)
                     pin      digits only
                     uuid     a random version-4 UUID (LENGTH is ignored)
  -c, --count N    print N secrets, one per line (default: 1)
  -h, --help       show this help

LENGTH is in characters (default: 32; 6 for pin).

Examples:
  $PROG                 # 32 letters and digits
  $PROG -t strong 20    # a password for a site with strict rules
  $PROG -t hex 64       # a 256-bit key as hex
  $PROG -t uuid -c 3
EOF
}

die() { printf '%s: %s\n' "$PROG" "$*" >&2; exit 1; }
usage_error() { printf '%s: %s\nTry "%s --help".\n' "$PROG" "$*" "$PROG" >&2; exit 2; }

type=alnum count=1 length=''
while [ $# -gt 0 ]; do
  case $1 in
    -t|--type)  [ $# -ge 2 ] || usage_error "$1 needs a value"; type=$2; shift ;;
    -c|--count) [ $# -ge 2 ] || usage_error "$1 needs a value"; count=$2; shift ;;
    -h|--help)  usage; exit 0 ;;
    -*)         usage_error "unknown option: $1" ;;
    *)          [ -z "$length" ] || usage_error "too many arguments"; length=$1 ;;
  esac
  shift
done

if [ -z "$length" ]; then
  if [ "$type" = pin ]; then length=6; else length=32; fi
fi
for value in "$length" "$count"; do
  case $value in ''|*[!0-9]*|0) usage_error "LENGTH and --count must be whole numbers above 0" ;; esac
done
[ -r /dev/urandom ] || die "/dev/urandom is not available"

# $1 characters drawn uniformly from the tr character set $2. tr -dc throws
# away every byte outside the set, so there's no modulo bias.
from_set() {
  # head closing the pipe makes tr exit with SIGPIPE; that's expected.
  (set +o pipefail; LC_ALL=C tr -dc "$2" </dev/urandom | head -c "$1")
}

# $1 random bytes as lowercase hex.
random_hex() { od -An -tx1 -N "$1" /dev/urandom | tr -d ' \n'; }

# Base64 of enough random bytes, cut to $1 characters.
random_b64() { head -c $(( $1 * 3 / 4 + 3 )) /dev/urandom | base64 | tr -d '\n=' | cut -c1-"$1"; }

one() {
  case $type in
    alnum)  from_set "$length" 'A-Za-z0-9' ;;
    pin)    from_set "$length" '0-9' ;;
    hex)    from_set "$length" '0-9a-f' ;;
    base64) random_b64 "$length" ;;
    url)    random_b64 "$length" | tr '+/' '-_' ;;
    strong)
      [ "$length" -ge 4 ] || usage_error "strong secrets need a length of at least 4"
      local secret
      # Redraw until every kind of character is present (fast for length >= 8).
      while :; do
        secret=$(from_set "$length" 'A-Za-z0-9!#%+,.:=?@^_~-')
        case $secret in *[a-z]*) ;; *) continue ;; esac
        case $secret in *[A-Z]*) ;; *) continue ;; esac
        case $secret in *[0-9]*) ;; *) continue ;; esac
        case $secret in *[!A-Za-z0-9]*) ;; *) continue ;; esac
        break
      done
      printf '%s' "$secret" ;;
    uuid)
      local h variant
      h=$(random_hex 16)
      # Version 4: the 13th hex digit is 4; the 17th is 8, 9, a or b.
      variant=$(printf '%x' $(( (0x${h:16:1} & 3) | 8 )))
      printf '%s-%s-4%s-%s%s-%s' "${h:0:8}" "${h:8:4}" "${h:13:3}" "$variant" "${h:17:3}" "${h:20:12}" ;;
    *) usage_error "unknown type '$type' (see --help)" ;;
  esac
}

i=0
while [ "$i" -lt "$count" ]; do
  one
  echo
  i=$((i + 1))
done
