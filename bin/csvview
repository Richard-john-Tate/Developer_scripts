#!/usr/bin/env python3
"""csvview: show a CSV or TSV file as an aligned table."""

import argparse
import csv
import io
import os
import re
import sys
import unicodedata

PROG = os.path.basename(sys.argv[0])

HELP = f"""\
Usage: {PROG} [options] [FILE]

Show a CSV file (or standard input) as a neatly aligned table, so you
can read it in the terminal. Quoted fields with commas, quotes or line
breaks inside are handled properly. The delimiter is detected
automatically: comma, tab, semicolon or pipe.

Number columns are right-aligned. Long cells are cut short with "..." and
line breaks inside a cell are shown as "\\n".

Options:
  -d, --delimiter C  use C as the delimiter ("tab" or "\\t" for tabs)
  -n, --rows N       show only the first N rows after the header
  -w, --width N      cut cells longer than N characters (default: 40;
                     0 for no limit)
  -H, --no-header    the first row is data, not column names
  -h, --help         show this help

Examples:
  {PROG} export.csv
  {PROG} -n 20 -w 25 big.csv | less -S
  psql -c "copy users to stdout with csv header" | {PROG}"""


class Parser(argparse.ArgumentParser):
    def error(self, message):
        sys.stderr.write(f'{PROG}: {message}\nTry "{PROG} --help".\n')
        sys.exit(2)


NUMBER = re.compile(r"^[-+]?(\d{1,3}(,\d{3})+|\d+)?(\.\d+)?([eE][-+]?\d+)?%?$")


def width(text):
    """Columns the text takes up in a terminal (CJK and emoji count as 2)."""
    total = 0
    for ch in text:
        if unicodedata.combining(ch):
            continue
        total += 2 if unicodedata.east_asian_width(ch) in "WF" else 1
    return total


def cut(text, limit):
    text = text.replace("\r\n", "\n").replace("\n", "\\n").replace("\t", " ")
    if limit and width(text) > limit:
        out, used = "", 0
        for ch in text:
            w = 2 if unicodedata.east_asian_width(ch) in "WF" else 1
            if used + w > limit - 3:
                break
            out += ch
            used += w
        text = out + "..."
    return text


def pad(text, size, right):
    space = " " * (size - width(text))
    return space + text if right else text + space


def main():
    parser = Parser(prog=PROG, add_help=False, allow_abbrev=False)
    parser.add_argument("-h", "--help", action="store_true")
    parser.add_argument("-d", "--delimiter")
    parser.add_argument("-n", "--rows", type=int)
    parser.add_argument("-w", "--width", type=int, default=40)
    parser.add_argument("-H", "--no-header", action="store_true")
    parser.add_argument("file", nargs="?", default="-")
    args = parser.parse_args()
    if args.help:
        print(HELP)
        return 0
    if args.rows is not None and args.rows < 0:
        parser.error("--rows can't be negative")
    if args.width < 0 or 0 < args.width < 4:
        parser.error("--width must be 0 (no limit) or at least 4")

    delimiter = args.delimiter
    if delimiter in ("tab", "\\t", "TAB"):
        delimiter = "\t"
    if delimiter is not None and len(delimiter) != 1:
        parser.error("--delimiter must be a single character (or 'tab')")

    try:
        raw = sys.stdin.buffer.read() if args.file == "-" else open(args.file, "rb").read()
    except OSError as err:
        sys.stderr.write(f"{PROG}: {args.file}: {err.strerror}\n")
        return 1
    text = raw.decode("utf-8-sig", errors="replace")
    if not text.strip():
        sys.stderr.write(f"{PROG}: {args.file if args.file != '-' else '(stdin)'} is empty\n")
        return 1

    if delimiter is None:
        if args.file.lower().endswith(".tsv"):
            delimiter = "\t"
        else:
            try:
                delimiter = csv.Sniffer().sniff(text[:65536], delimiters=",\t;|").delimiter
            except csv.Error:
                delimiter = ","

    reader = csv.reader(io.StringIO(text, newline=""), delimiter=delimiter)
    limit = None if args.rows is None else args.rows + (0 if args.no_header else 1)
    rows = []
    try:
        for row in reader:
            if limit is not None and len(rows) >= limit:
                break
            rows.append([cut(cell, args.width) for cell in row])
    except csv.Error as err:
        sys.stderr.write(f"{PROG}: line {reader.line_num}: {err}\n")
        return 1
    if not rows:
        return 0

    columns = max(len(row) for row in rows)
    for row in rows:
        row.extend([""] * (columns - len(row)))
    header = None if args.no_header else rows[0]
    body = rows if args.no_header else rows[1:]

    sizes = [max(width(row[c]) for row in rows) for c in range(columns)]
    numeric = [bool(body) and all(NUMBER.match(row[c].strip()) for row in body if row[c].strip())
               and any(row[c].strip() for row in body) for c in range(columns)]

    def line(row):
        return " | ".join(pad(row[c], sizes[c], numeric[c]) for c in range(columns)).rstrip()

    if header is not None:
        print(line(header))
        print("-+-".join("-" * s for s in sizes))
    for row in body:
        print(line(row))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
    except BrokenPipeError:
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        sys.exit(0)
