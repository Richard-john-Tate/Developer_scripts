#!/usr/bin/env bash
#
# extract: unpack any common archive with one command.
#
set -euo pipefail

readonly PROG=${0##*/}

usage() {
  cat <<EOF
Usage: $PROG [options] ARCHIVE...

Unpack archives without remembering which tool and flags each format
needs. Works out the format from the file name.

Supported: .tar .tar.gz .tgz .tar.bz2 .tbz2 .tar.xz .txz .tar.zst .tzst
           .tar.lz .tar.lzma .tar.Z .zip .jar .war .whl .gz .bz2 .xz
           .zst .lzma .Z .7z .rar

Options:
  -d, --dest DIR   unpack into DIR (created if needed; default: the
                   current directory)
  -f, --force      overwrite files that already exist in DIR
  -l, --list       list what's inside instead of unpacking
  -h, --help       show this help

Without --force nothing is ever overwritten. Archives are unpacked into a
temporary folder first; if any top-level file or folder in the archive
already exists in DIR, extract stops and leaves DIR as it was.

Examples:
  $PROG release.tar.gz
  $PROG -d /tmp/src project.zip
  $PROG -l backup.tar.xz
EOF
}

die() { printf '%s: %s\n' "$PROG" "$*" >&2; exit 1; }
usage_error() { printf '%s: %s\nTry "%s --help".\n' "$PROG" "$*" "$PROG" >&2; exit 2; }
have() { command -v "$1" >/dev/null 2>&1; }
need() { have "$1" || die "'$1' is needed for $2 files but isn't installed"; }

dest=. list=0 force=0 archives=()
while [ $# -gt 0 ]; do
  case $1 in
    -d|--dest)  [ $# -ge 2 ] || usage_error "$1 needs a value"; dest=$2; shift ;;
    -f|--force) force=1 ;;
    -l|--list)  list=1 ;;
    -h|--help)  usage; exit 0 ;;
    --)         shift; archives+=("$@"); break ;;
    -*)         usage_error "unknown option: $1" ;;
    *)          archives+=("$1") ;;
  esac
  shift
done
[ ${#archives[@]} -gt 0 ] || usage_error "give at least one archive"
case $dest in -*) dest=./$dest ;; esac
[ "$list" -eq 1 ] || mkdir -p "$dest"

# Decompress a single compressed file (not a tarball) into $dest.
#   $1 = archive, $2 = suffix to strip, $3... = decompress-to-stdout command
unpack_single() {
  local file=$1 suffix=$2 name out
  shift 2
  name=$(basename "$file")
  name=${name%"$suffix"}
  out=$dest/$name
  [ "$force" -eq 1 ] || [ ! -e "$out" ] || die "$out already exists; not overwriting (use --force)"
  # Write to a temporary name so a failure never leaves half a file.
  if ! "$@" <"$file" >"$out.partial.$$"; then
    rm -f "$out.partial.$$"
    die "failed to decompress $file"
  fi
  mv -f "$out.partial.$$" "$out"
  echo "$file -> $out"
}

# Unpack archive $1 (format from its lowercased name $2) into folder $3.
# Never prompts: --force overwrites, and otherwise $3 is a fresh folder.
unpack_into() {
  case $2 in
    *.tar.zst|*.tzst) zstd -dc "$1" | tar -xf - -C "$3" ;;
    *.zip|*.jar|*.war|*.ear|*.whl|*.apk|*.xpi) unzip -q -o "$1" -d "$3" ;;
    *.7z)  7z x -y -o"$3" "$1" >/dev/null ;;
    *.rar) unrar x -o+ -idq "$1" "$3/" ;;
    *)     tar -xf "$1" -C "$3" ;;   # GNU and BSD tar detect the compression
  esac
}

# Unpack into a temporary folder inside $dest, then move the contents into
# place, unless something with the same name is already there.
unpack_safely() {
  local archive=$1 lower=$2 work entry name clashes=''
  work=$(mktemp -d "$dest/.extract.XXXXXX")
  if ! unpack_into "$archive" "$lower" "$work"; then
    rm -rf "$work"
    die "failed to extract $archive"
  fi
  for entry in "$work"/* "$work"/.[!.]* "$work"/..?*; do
    [ -e "$entry" ] || [ -L "$entry" ] || continue   # unmatched glob
    name=${entry##*/}
    if [ -e "$dest/$name" ] || [ -L "$dest/$name" ]; then clashes="$clashes $name"; fi
  done
  if [ -n "$clashes" ]; then
    rm -rf "$work"
    die "not extracting $archive: these already exist in $dest:$clashes (use --force to overwrite, or -d to unpack somewhere else)"
  fi
  for entry in "$work"/* "$work"/.[!.]* "$work"/..?*; do
    [ -e "$entry" ] || [ -L "$entry" ] || continue
    mv "$entry" "$dest/"
  done
  rmdir "$work"
}

for archive in "${archives[@]}"; do
  [ -f "$archive" ] || die "no such file: $archive"
  case $archive in -*) archive=./$archive ;; esac   # so tools don't see an option
  lower=$(printf '%s' "$archive" | tr '[:upper:]' '[:lower:]')

  case $lower in
    *.tar.zst|*.tzst|*.zst) need zstd zstd ;;
    *.zip|*.jar|*.war|*.ear|*.whl|*.apk|*.xpi) need unzip zip ;;
    *.7z)  need 7z 7z ;;
    *.rar) need unrar rar ;;
  esac

  if [ "$list" -eq 1 ]; then
    case $lower in
      *.tar|*.tar.gz|*.tgz|*.tar.bz2|*.tbz|*.tbz2|*.tar.xz|*.txz|*.tar.lzma|*.tar.lz|*.tar.z)
        tar -tf "$archive" ;;
      *.tar.zst|*.tzst) zstd -dc "$archive" | tar -tf - ;;
      *.zip|*.jar|*.war|*.ear|*.whl|*.apk|*.xpi) unzip -l "$archive" ;;
      *.7z)  7z l "$archive" ;;
      *.rar) unrar l "$archive" ;;
      *.gz|*.bz2|*.xz|*.zst|*.lzma|*.z)
        echo "$archive: a single compressed file, not an archive" ;;
      *) die "don't know how to list '$archive'" ;;
    esac
    continue
  fi

  case $lower in
    *.tar|*.tar.gz|*.tgz|*.tar.bz2|*.tbz|*.tbz2|*.tar.xz|*.txz|*.tar.lzma|*.tar.lz|*.tar.z|\
    *.tar.zst|*.tzst|*.zip|*.jar|*.war|*.ear|*.whl|*.apk|*.xpi|*.7z|*.rar)
      if [ "$force" -eq 1 ]; then
        unpack_into "$archive" "$lower" "$dest"
      else
        unpack_safely "$archive" "$lower"
      fi
      echo "$archive -> $dest/" ;;
    *.gz)   need gzip gzip;   unpack_single "$archive" "${archive: -3}" gzip -dc ;;
    *.bz2)  need bzip2 bzip2; unpack_single "$archive" "${archive: -4}" bzip2 -dc ;;
    *.xz)   need xz xz;       unpack_single "$archive" "${archive: -3}" xz -dc ;;
    *.lzma) need xz lzma;     unpack_single "$archive" "${archive: -5}" xz --format=lzma -dc ;;
    *.zst)  unpack_single "$archive" "${archive: -4}" zstd -dc ;;
    *.z)    need gzip Z;      unpack_single "$archive" "${archive: -2}" gzip -dc ;;
    *)      die "don't know how to extract '$archive'" ;;
  esac
done
